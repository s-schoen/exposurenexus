{
  "name": "exposurenexus",
  "version": "0.1.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "s-schoen",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "coverage:api": "pnpm --filter @exposurenexus/api^... build && pnpm --filter @exposurenexus/api test:coverage",
    "coverage:contracts": "pnpm --filter @exposurenexus/contracts^... build && pnpm --filter @exposurenexus/contracts test:coverage",
    "coverage:ui": "pnpm --filter @exposurenexus/ui^... build && pnpm --filter @exposurenexus/ui test:coverage",
    "dev:api": "pnpm --filter @exposurenexus/api^... build && pnpm --filter @exposurenexus/api dev",
    "dev:ui": "pnpm --filter @exposurenexus/ui^... build && pnpm --filter @exposurenexus/ui dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm --filter @exposurenexus/contracts build && oxlint .",
    "lint:agent": "pnpm --filter @exposurenexus/contracts build && oxlint --format=agent .",
    "lint:fix": "pnpm --filter @exposurenexus/contracts build && oxlint --fix .",
    "storybook:ui": "pnpm --filter @exposurenexus/ui^... build && pnpm --filter @exposurenexus/ui storybook",
    "test": "pnpm test:contracts && pnpm test:api && pnpm test:ui",
    "test:api": "pnpm --filter @exposurenexus/api^... build && pnpm --filter @exposurenexus/api test",
    "test:contracts": "pnpm --filter @exposurenexus/contracts build && pnpm --filter @exposurenexus/contracts typecheck:test && pnpm --filter @exposurenexus/contracts test",
    "test:ui": "pnpm --filter @exposurenexus/ui^... build && pnpm --filter @exposurenexus/ui test",
    "test:ui:unit": "pnpm --filter @exposurenexus/ui^... build && pnpm --filter @exposurenexus/ui test:unit",
    "verify:container": "sh scripts/verify-container-build.sh",
    "worktree": "bash scripts/worktree.sh"
  },
  "devDependencies": {
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
