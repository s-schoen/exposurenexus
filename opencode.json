{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "pnpm --filter @exposurenexus/ui build-storybook *": "allow",
      "pnpm --filter @exposurenexus/ui build *": "allow",
      "pnpm format *": "allow",
      "pnpm format:check *": "allow",
      "pnpm lint *": "allow",
      "pnpm lint:agent *": "allow",
      "pnpm lint:fix *": "allow",
      "pnpm --filter @exposurenexus/ui test *": "allow",
      "pnpm --filter @exposurenexus/ui test:unit *": "allow",
      "pnpm --filter @exposurenexus/ui test:coverage *": "allow"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["pnpm", "dlx", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "timeout": 20000
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "webstorm": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream",
      "enabled": true
    },
    "storybook": {
      "type": "remote",
      "url": "http://localhost:6006/mcp",
      "enabled": true
    }
  }
}
