{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["pnpm", "dlx", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "timeout": 20000
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "webstorm": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream",
      "enabled": true
    },
    "storybook": {
      "type": "remote",
      "url": "http://localhost:6006/mcp",
      "enabled": true
    }
  }
}
