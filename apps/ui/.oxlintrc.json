                "regex": "(?:^@/test(?:/|$)|\\.(?:test|spec|stories)(?:\\.|$))",
                "message": "Production modules must not import test or story support."
              },
              {
                "regex": "^@/(?:features|routes|api|context|integrations)(?:/|$)",
                "message": "Follow the shared-layer dependency direction."
              },
              {
                "regex": "^@exposurenexus/contracts(?:/|$)",
                "message": "Domain contracts belong in features."
              },
              {
                "group": ["./*", "../*"],
                "message": "Use the @/ alias for imports in manual UI source files."
