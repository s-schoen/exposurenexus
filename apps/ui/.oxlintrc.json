      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "message": "Consume features through their public root only.",
                "regex": "^@/features/[^/]+/"
              },
              {
                "group": ["./*", "../*"],
                "message": "Use the @/ alias for imports in manual UI source files."
              },
              {
                "group": ["@/api", "@/api/**", "@/context", "@/context/**"],
                "message": "Import domain functionality from its feature public interface."
              }
            ]
          }
        ]
      }
    },
