{
  "name": "@exposurenexus/api",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile=coverage/test-results.junit.xml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@exposurenexus/contracts": "workspace:*",
    "@exposurenexus/jobs": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "hono": "^4.13.5",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
