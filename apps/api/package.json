{
  "name": "@openvlp/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "eslint src/** && prettier --check src/**",
    "check:fix": "eslint --fix src/** && prettier --write src/**"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@t3-oss/env-core": "^0.13.10",
    "hono": "^4.11.1",
