{
  "name": "@exposurenexus/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "check": "eslint src/** && prettier --check src/**",
    "check:fix": "eslint --fix src/** && prettier --write src/**"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@exposurenexus/types": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "hono": "^4.12.16",
    "kysely": "^0.29.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "kysely-pglite-dialect": "^1.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.4"
  }
}
