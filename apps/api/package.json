    "zod": "^4.2.1",
    "@openvlp/types": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.11.17",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.50.0"
  }
