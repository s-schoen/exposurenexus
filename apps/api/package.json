{
  "name": "@openvlp/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "check": "eslint src/** && prettier --check src/**",
    "check:fix": "eslint --fix src/** && prettier --write src/**"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@hono/zod-validator": "^0.7.6",
    "@openvlp/types": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.6.2",
    "hono": "^4.12.12",
    "kysely": "^0.28.16",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "kysely-pglite-dialect": "^1.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.4"
  }
}
