    "better-auth": "^1.4.18",
    "hono": "^4.11.7",
    "kysely": "^0.28.10",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
